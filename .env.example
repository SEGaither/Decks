# Resend email delivery (obtain from resend.com)
RESEND_API_KEY=

# Email address that receives lead notifications
LEAD_NOTIFICATION_EMAIL=

# Verified sender address for outbound notifications (must match your Resend domain)
LEAD_FROM_EMAIL=

# Public site URL — no trailing slash (e.g. https://www.daychangerdecks.com)
NEXT_PUBLIC_SITE_URL=
